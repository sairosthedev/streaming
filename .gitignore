node_modules/
.env
.env*.local
.next/
.vercel/
pc/hls/
pc/.agent-hls/

# MediaMTX: a 30 MB binary, fetched by `npm run setup`, plus the config we
# generate from .env on every start (it contains the camera password).
pc/bin/

*.log
.DS_Store
Thumbs.db

# Package guard: model weights (downloaded on first run), saved theft clips,
# and the private photos used to recognise known people. None belong in git.
guard/*.pt
guard/events/
guard/known_faces/*.jpg
guard/known_faces/*.jpeg
guard/known_faces/*.png

# Camera URLs doc: contains the stream key and view password in plaintext.
docs/camera-urls.md

# Offline registry cache: last known good camera list, contains passwords.
pc/.cache/

# Site runbooks: contain camera credentials and network layout.
docs/site-*.md

# Camera URL exports: contain the stream key and view password.
camera-urls*.txt

# Camera URL exports (stream key + view password)
/camera-urls-cloudflare.txt
camera-urls-cloudflare.txt

# ML model weights and training runs (large; regenerated)
weights/
runs/
